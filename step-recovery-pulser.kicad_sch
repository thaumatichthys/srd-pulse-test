	(text_box "Test board for the only step recovery diode that i can access, to make a high speed (200ps range) pulse generator."
		(exclude_from_sim no)
		(at 69.85 34.29 0)
		(size 54.61 20.32)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "9b1d6f0a-78e9-4170-ae98-abce8239311f")
	)
	(text_box "According to datasheet the GaN driver can do rise and fall times of ~2 ns.\nThe pulses get fed into the SRD and turn into a fast risetime pulse, with slower tail.\nThe microstrip stub then turns it into a 200 ps pulse."
		(exclude_from_sim no)
		(at 261.62 43.1947 0)
		(size 31.75 20.3053)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "af0d64f3-fde5-4908-872e-edb5b0d25206")
	)
	(text_box "Important for jitter: the strobe happens on the rising edge of the input clock.\n\nTo limit the slew rate of the lower GaN FET, there is a feature of the EPC23104 that does this.\n"
		(exclude_from_sim no)
		(at 281.94 131.1039 0)
		(size 35.56 16.2161)
		(margins 0.9525 0.9525 0.9525 0.9525)
		(stroke
			(width 0)
			(type solid)
		)
		(fill
			(type none)
		)
		(effects
			(font
				(size 1.27 1.27)
			)
			(justify left top)
		)
		(uuid "ce2eadf7-f2df-4353-af9e-f4329f172875")
	)
