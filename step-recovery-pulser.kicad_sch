			)
			(justify left top)
		)
		(uuid "af0d64f3-fde5-4908-872e-edb5b0d25206")
	)
	(text_box "Important for jitter: the strobe happens on the rising edge of the input clock.\n\nTo limit the slew rate of the lower GaN FET, there is a feature of the EPC23104 that does this.\n"
		(exclude_from_sim no)
		(at 271.78 89.1939 0)
		(size 35.56 16.2161)
